# ===========================
# ZeroConfig Monorepo .gitignore
# ===========================

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
pnpm-lock.yaml

# --- Next.js ---
apps/web/.next/
apps/web/out/
apps/web/build/

# --- Environment & Secrets (NEVER commit) ---
.env
.env.*
!.env.render.example

# --- Prisma local database ---
apps/web/prisma/dev.db
apps/web/prisma/dev.db-journal
apps/web/prisma/*.db

# --- Go build artifacts ---
apps/proxy/proxy.exe
apps/proxy/proxy.exe~
apps/proxy/proxy

# --- OS / Editor ---
.DS_Store
*.pem
.vscode/
*.tsbuildinfo
next-env.d.ts

# --- Vercel ---
.vercel

# --- Test folders ---
test_project/
