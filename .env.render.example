# Copy these into Render Dashboard → Environment → Add Environment Variable
# for the "zeroconfig-web" service

DATABASE_URL=postgresql://...from neon.tech...

NEXTAUTH_SECRET=zero-config-super-secret-12345
NEXTAUTH_URL=https://zeroconfig-web.onrender.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=ZeroConfig <your-email@gmail.com>
